# Runtime
NODE_ENV=production
PORT=8080
STATIC_SITE_DIR=/app/public
SUBMISSIONS_DATA_DIR=/app/data
# Leave unset when the application is directly exposed. If a trusted reverse
# proxy is always present, set its exact hop count (for example, 1).
# TRUST_PROXY_HOPS=1

# Public release identity
NP_RELEASE_VERSION=v1.2.35
SOURCE_REVISION=0000000000000000000000000000000000000000

# Browser and API origin policy
BOARD_PUBLIC_WEB_URL=https://np-servicerequest.org
BOARD_ALLOWED_ORIGINS=https://np-servicerequest.org
NUXT_PUBLIC_API_BASE_URL=/api
ANTI_BOT_SECRET=replace-with-at-least-32-random-bytes

# Administrative access
# Use a unique value with at least 32 characters. Prefer BOARD_ADMIN_KEYS when
# rotating keys so the old and new key can overlap briefly.
BOARD_ADMIN_KEY=replace-with-a-unique-random-admin-key
# BOARD_ADMIN_KEYS=current-key,previous-key-during-a-short-rotation-window

# Mail delivery
ENABLE_BOARD_EMAIL_NOTIFICATIONS=false
ENABLE_BOARD_MANAGEMENT_EMAILS=true
ENABLE_BOARD_REPLY_NOTIFICATION_EMAILS=true
BOARD_NOTIFICATION_EMAIL_TO=servicerequest@jacobdanderson.net
BOARD_NOTIFICATION_EMAIL_FROM=no-reply@np-servicerequest.org
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Optional live service directory
IDEALIST_API_KEY=
IDEALIST_INITIAL_SYNC_DAYS=45
IDEALIST_SYNC_TTL_MINUTES=360
IDEALIST_MIN_REFRESH_MINUTES=15

# Build-only option
DISABLE_ANALYTICS=false
