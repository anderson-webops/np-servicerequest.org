# Local process defaults. Production must use the checked systemd unit and
# /etc/np-servicerequest/service.env rather than copying this file unchanged.
NODE_ENV=development
HOST=127.0.0.1
PORT=3006
# Use absolute paths when exercising a built local runtime.
# STATIC_SITE_DIR=/absolute/path/to/front-end/.output/public
# SUBMISSIONS_DATA_DIR=/absolute/path/to/private-local-data
ALLOW_PUBLIC_LISTENER=false
ALLOW_EPHEMERAL_DATA_DIR=false

# The direct production unit fixes this to one trusted host-local Nginx hop.
TRUST_PROXY_HOPS=0

# Browser and API origin policy
BOARD_PUBLIC_WEB_URL=https://np-servicerequest.org
BOARD_ALLOWED_ORIGINS=https://np-servicerequest.org
NUXT_PUBLIC_API_BASE_URL=/api
ANTI_BOT_SECRET=

# Administrative access. Production requires at least one unique key from 32
# through 512 characters. Prefer BOARD_ADMIN_KEYS for a short rotation overlap.
BOARD_ADMIN_KEY=
# BOARD_ADMIN_KEYS=current-key,previous-key-during-a-short-rotation-window

# Mail delivery
ENABLE_BOARD_EMAIL_NOTIFICATIONS=false
ENABLE_BOARD_MANAGEMENT_EMAILS=true
ENABLE_BOARD_REPLY_NOTIFICATION_EMAILS=true
BOARD_NOTIFICATION_EMAIL_TO=servicerequest@jacobdanderson.net
BOARD_NOTIFICATION_EMAIL_FROM=no-reply@np-servicerequest.org
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Optional live service directory
IDEALIST_API_KEY=
IDEALIST_INITIAL_SYNC_DAYS=45
IDEALIST_SYNC_TTL_MINUTES=360
IDEALIST_MIN_REFRESH_MINUTES=15

# Build-only option
DISABLE_ANALYTICS=false
