{
	"name": "back-end",
	"version": "1.3.9",
	"private": true,
	"packageManager": "npm@12.2.2",
	"engines": {
		"node": ">=26.13.0 <27",
		"npm": ">=12.2.2 <13"
	},
	"description": "Minimal Express API for np-servicerequest.org.",
	"type": "module",
	"main": "dist/server.js",
	"scripts": {
		"server": "tsx watch -r dotenv/config src/server.ts",
		"server:once": "node --import tsx -r dotenv/config src/server.ts",
		"start": "node dist/server.js",
		"build": "node scripts/run-typescript.mjs -p tsconfig.json --incremental false",
		"watch": "node scripts/run-typescript.mjs -w",
		"dev": "tsx watch -r dotenv/config src/server.ts",
		"test": "node --import tsx --test src/**/*.test.ts",
		"typecheck": "node scripts/run-typescript.mjs -p tsconfig.json --noEmit",
		"up": "taze major -I",
		"lint": "eslint \"src/**/*.{js,ts}\" \"scripts/**/*.mjs\"",
		"lint-fix": "eslint \"src/**/*.{js,ts}\" \"scripts/**/*.mjs\" --fix"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"cors": "^2.8.6",
		"dotenv": "^18.0.9",
		"express": "^5.3.0",
		"helmet": "^8.3.0",
		"nodemailer": "^10.3.1",
		"cookie": "file:vendor/cookie-2.0.2-webops.2.tgz",
		"encodeurl": "file:vendor/encodeurl-3.0.0-webops.2.tgz",
		"raw-body": "file:vendor/raw-body-4.0.0-webops.2.tgz",
		"type-is": "file:vendor/type-is-3.0.0-webops.2.tgz"
	},
	"devDependencies": {
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/node": "^26.6.6",
		"@types/nodemailer": "^8.0.2",
		"globals": "^17.14.0",
		"tsx": "^4.23.15",
		"typescript-eslint": "^8.72.1",
		"typescript-native": "npm:typescript@7.0.2"
	}
}
