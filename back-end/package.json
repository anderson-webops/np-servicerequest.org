{
	"name": "back-end",
	"version": "1.0.0",
	"private": true,
	"packageManager": "npm@11.16.0",
	"engines": {
		"node": ">=24.18.0 <25",
		"npm": ">=11.16.0 <12"
	},
	"description": "Minimal Express API for np-servicerequest.org.",
	"type": "module",
	"main": "dist/server.js",
	"scripts": {
		"server": "tsx watch -r dotenv/config src/server.ts",
		"server:once": "tsx -r dotenv/config src/server.ts",
		"start": "node dist/server.js",
		"build": "tsc -p tsconfig.json",
		"watch": "tsc -w",
		"dev": "tsx watch -r dotenv/config src/server.ts",
		"test": "tsx --test src/**/*.test.ts",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"up": "taze major -I",
		"lint": "eslint \"src/**/*.{js,ts}\"",
		"lint-fix": "eslint \"src/**/*.{js,ts}\" --fix"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"cors": "^2.8.5",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"helmet": "^8.1.0",
		"nodemailer": "^9.0.1"
	},
	"devDependencies": {
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/node": "^24.13.3",
		"@types/nodemailer": "^8.0.0",
		"globals": "^17.4.0",
		"tsx": "^4.22.4",
		"typescript-eslint": "^8.59.0"
	},
	"overrides": {
		"body-parser": "2.3.0",
		"brace-expansion": "5.0.8",
		"esbuild": "0.28.1",
		"js-yaml": "4.3.0",
		"postcss": "8.5.24",
		"qs": "6.15.3",
		"vite": "8.1.5"
	}
}
