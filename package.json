{
	"name": "np-servicerequest-org-monorepo",
	"type": "module",
	"version": "1.3.0",
	"private": true,
	"packageManager": "npm@12.0.2",
	"engines": {
		"node": ">=24.18.1 <25",
		"npm": ">=12.0.2 <13"
	},
	"description": "Monorepo for np-servicerequest.org",
	"author": "Jacob Anderson",
	"license": "ISC",
	"keywords": [],
	"workspaces": [
		"front-end",
		"back-end"
	],
	"scripts": {
		"audit": "npm audit --workspaces --include-workspace-root --audit-level=low && npm run audit:qs",
		"audit:production": "npm audit --workspaces --include-workspace-root --omit=dev --audit-level=low",
		"audit:signatures": "npm audit signatures",
		"audit-fix": "npm audit fix --workspaces --include-workspace-root",
		"build": "npm run -w front-end build && npm run verify:analytics && npm run -w back-end build && npm run release:metadata",
		"build:netlify": "npm run -w front-end build && npm run verify:analytics && npm run release:metadata && node scripts/write-netlify-headers.mjs",
		"dev": "npm run -w front-end dev",
		"server": "npm run -w back-end server",
		"server:once": "npm run -w back-end server:once",
		"serve": "npm run -w front-end serve",
		"preview": "npm run -w front-end preview",
		"release:metadata": "node scripts/write-release-metadata.mjs",
		"postinstall": "simple-git-hooks && npm run -w front-end prepare",
		"lint-server": "npm run -w back-end lint-fix && npm run -w back-end server",
		"lint-serve": "npm run -w front-end lint-fix && npm run -w front-end serve",
		"lint": "npm run lint:root && npm run -w front-end lint && npm run -w back-end lint",
		"lint:root": "eslint \"scripts/**/*.mjs\" eslint.config.js playwright.config.ts",
		"lint-fix": "npm run -w front-end lint-fix && npm run -w back-end lint-fix",
		"test:e2e": "DISABLE_ANALYTICS=true NUXT_PUBLIC_API_BASE_URL=/api npm run build && playwright test && npm run build",
		"typecheck": "npm run -w front-end typecheck && npm run -w back-end typecheck",
		"verify:analytics": "node scripts/verify-analytics-scripts.mjs",
		"clean": "rm -rf node_modules front-end/node_modules front-end/.nuxt front-end/.output back-end/node_modules back-end/dist",
		"roles:account": "node back-end/scripts/manage-account-role.mjs",
		"sanitize:network-metadata": "node back-end/scripts/sanitize-network-metadata.mjs",
		"test": "node --test scripts/*.test.mjs scripts/test-braces-compat.mjs scripts/test-listhen-compat.mjs scripts/test-deepmerge-compat.mjs scripts/test-qs-compat.mjs scripts/test-vendored-qs-packaging.mjs scripts/test-vue-devtools-compat.mjs && npm run -w back-end test && python3 -B -m unittest scripts/test_runtime_artifact.py -v && npm run test:devtools",
		"up": "taze major -I && npm run -w front-end up && npm run -w back-end up",
		"a11y": "node scripts/a11y-smoke.mjs",
		"verify:dependency-graph": "node scripts/verify-dependency-graph.mjs",
		"verify:native-lock": "node scripts/verify-native-lock.mjs",
		"verify:platform-install": "node scripts/verify-platform-install.mjs",
		"verify:production": "node scripts/post-deploy-smoke.mjs",
		"smoke:backend-runtime": "node scripts/backend-runtime-smoke.mjs",
		"package:runtime": "bash scripts/package-runtime.sh",
		"test:promotion": "bash scripts/test-promotion-recovery.sh",
		"package:qs": "node scripts/package-vendored-qs.mjs",
		"check:qs-package": "node scripts/package-vendored-qs.mjs --check",
		"package:vue-devtools": "node scripts/package-vendored-vue-devtools.mjs",
		"check:vue-devtools-package": "node scripts/package-vendored-vue-devtools.mjs --check",
		"test:devtools": "node scripts/test-vue-devtools-host.mjs",
		"audit:qs": "npm audit --prefix vendor/qs --workspaces=false --audit-level=low && npm audit --prefix vendor/qs --workspaces=false --omit=dev --audit-level=low"
	},
	"devDependencies": {
		"@vitejs/devtools-kit": "^0.7.6",
		"@antfu/eslint-config": "^10.0.0",
		"@playwright/test": "^1.62.1",
		"axe-core": "^4.14.0",
		"braces": "file:vendor/braces",
		"commander": "15.0.0",
		"deepmerge": "file:vendor/deepmerge",
		"eslint": "^10.13.0",
		"eslint-plugin-format": "^2.0.1",
		"lint-staged": "^17.2.0",
		"listhen": "file:vendor/listhen",
		"puppeteer": "^25.16.0",
		"rollup": "4.66.0",
		"simple-git-hooks": "^2.14.0",
		"taze": "^21.3.0",
		"typescript": "^6.0.3",
		"esbuild": "^0.28.2",
		"eslint-plugin-slop": "^0.1.3",
		"eslint-plugin-sonarjs": "^4.2.2",
		"qs": "file:back-end/vendor/qs-6.17.2-webops.1.tgz",
		"vite-plugin-vue-devtools": "file:vendor/vite-plugin-vue-devtools-9.0.0-rc.2-webops.1.tgz"
	},
	"simple-git-hooks": {
		"pre-commit": "test -x ./node_modules/.bin/lint-staged || { echo 'lint-staged is not installed. Run npm install.'; exit 1; }; ./node_modules/.bin/lint-staged"
	},
	"lint-staged": {
		"*.{js,ts,vue,mjs,cjs}": [
			"eslint --fix"
		]
	},
	"overrides": {
		"braces": "$braces",
		"listhen": "$listhen",
		"deepmerge": "$deepmerge",
		"nanoid@^3": "3.3.18",
		"@bomb.sh/tab": {
			"cac": "7.0.0"
		},
		"esbuild": "^0.28.2",
		"js-yaml": "4.3.2",
		"launch-editor": {
			".": "2.14.2",
			"shell-quote": "1.12.0"
		},
		"shell-quote": "1.12.0",
		"vite": {
			".": "^8.3.5",
			"esbuild": "^0.28.2"
		},
		"nitropack": "2.13.5",
		"brace-expansion": "5.0.12",
		"fast-uri": "3.1.9",
		"serialize-javascript": "7.1.4",
		"glob": "13.0.6",
		"postcss": "8.5.32",
		"qs": "$qs",
		"rolldown": "1.2.16",
		"rollup": "4.66.0",
		"tinypool": "2.2.0",
		"katex": "0.19.1",
		"svgo": "4.1.0",
		"tar": "7.5.22",
		"valibot": "1.5.0",
		"unimport@7.0.2": "7.0.1",
		"@nuxt/devtools": {
			"launch-editor": "2.14.2"
		},
		"vite-plugin-vue-devtools@^9.0.0-beta.1": "$vite-plugin-vue-devtools",
		"devalue@^5": "5.9.4",
		"simple-git@^3": "3.36.0"
	},
	"allowScripts": {
		"esbuild@0.28.2": true,
		"fsevents@2.3.2": true,
		"fsevents@2.3.3": true,
		"puppeteer@25.16.0": false,
		"unrs-resolver@1.12.2": true,
		"simple-git-hooks": false
	}
}
