# Direct Nginx edge for np-servicerequest.org.
#
# The single loopback Node process serves the generated frontend and API from
# the atomic release selected by deploy/systemd/promote-release.sh. Preserve
# the application's generated hash-based Content-Security-Policy.

upstream np_servicerequest_origin {
	server 127.0.0.1:3006;
	keepalive 16;
}

server {
	listen 80;
	listen [::]:80;
	server_name np-servicerequest.org www.np-servicerequest.org;
	server_tokens off;

	location ^~ /.well-known/acme-challenge/ {
		root /var/www/acme;
		try_files $uri =404;
	}

	return 301 https://np-servicerequest.org$request_uri;
}

server {
	listen 443 ssl http2;
	listen [::]:443 ssl http2;
	server_name np-servicerequest.org www.np-servicerequest.org;
	server_tokens off;

	# Certificate paths are host-managed and intentionally not committed.
	# ssl_certificate /etc/letsencrypt/live/np-servicerequest.org/fullchain.pem;
	# ssl_certificate_key /etc/letsencrypt/live/np-servicerequest.org/privkey.pem;
	if ($host != np-servicerequest.org) {
		return 301 https://np-servicerequest.org$request_uri;
	}

	client_max_body_size 100k;

	location / {
		proxy_http_version 1.1;
		proxy_pass http://np_servicerequest_origin;
		proxy_connect_timeout 3s;
		proxy_send_timeout 30s;
		proxy_read_timeout 30s;
		proxy_next_upstream off;

		proxy_set_header Host $host;
		proxy_set_header X-Forwarded-For $remote_addr;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header Connection "";
		proxy_hide_header Server;
	}
}
