# Install as /etc/np-servicerequest/service.env with mode 0600.
# NODE_ENV, HOST, PORT, listener policy, proxy trust, static location, and the
# durable data location are fixed by the systemd unit and cannot be overridden
# here.

BOARD_PUBLIC_WEB_URL=https://np-servicerequest.org
BOARD_ALLOWED_ORIGINS=https://np-servicerequest.org
ANTI_BOT_SECRET=

# Prefer BOARD_ADMIN_KEYS while rotating so old and new values overlap only
# for the short rotation window. Every configured production key must contain
# from 32 through 512 characters.
BOARD_ADMIN_KEY=
# BOARD_ADMIN_KEYS=current-key,previous-key-during-a-short-rotation-window

ENABLE_BOARD_EMAIL_NOTIFICATIONS=false
ENABLE_BOARD_MANAGEMENT_EMAILS=true
ENABLE_BOARD_REPLY_NOTIFICATION_EMAILS=true
BOARD_NOTIFICATION_EMAIL_TO=servicerequest@jacobdanderson.net
BOARD_NOTIFICATION_EMAIL_FROM=no-reply@np-servicerequest.org
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

IDEALIST_API_KEY=
IDEALIST_INITIAL_SYNC_DAYS=45
IDEALIST_SYNC_TTL_MINUTES=360
IDEALIST_MIN_REFRESH_MINUTES=15
